FROM muqrizmarzuki25/laraveldebian-php8.3:esilibus

WORKDIR /var/www

# Step 1: Copy only dependency definitions first (caches Composer & NPM layers)
COPY composer.json composer.lock package.json package-lock.json* ./

# Step 2: Install dependencies without running package scripts yet
RUN composer install --no-interaction --no-dev --no-scripts --no-autoloader --prefer-dist \
    && npm ci --no-audit --prefer-offline 2>/dev/null || npm install --no-audit

# Step 3: Copy full application files
COPY . /var/www

# Step 4: Build assets, clean up node_modules to save hundreds of MBs, and finalize Composer
RUN npm run build \
    && rm -rf node_modules \
    && composer dump-autoload --optimize --no-dev \
    && php artisan storage:link

# Step 5: Fix permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
    && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

EXPOSE 80

# Run supervisor via exec so it receives OS termination signals (SIGTERM) properly in Kubernetes
CMD ["/bin/sh", "-c", "php artisan config:cache && php artisan route:cache && php artisan view:cache && exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf"]
