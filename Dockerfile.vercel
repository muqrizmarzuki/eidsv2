FROM muqrizmarzuki25/laraveldebian-php8.3:esilibus

WORKDIR /var/www

# Step 1: Copy only dependency definitions first (caches Composer & pnpm layers)
COPY composer.json composer.lock package.json pnpm-lock.yaml* ./

# Step 2: Install PostgreSQL PDO extension and dependencies cleanly
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq-dev \
    && docker-php-ext-configure pdo_pgsql --with-pdo-pgsql=/usr \
    && docker-php-ext-install -j$(nproc) pdo pdo_pgsql pgsql \
    && docker-php-ext-enable pdo_pgsql pgsql \
    && rm -rf /var/lib/apt/lists/*

# Step 3: Install dependencies using pnpm & Composer
RUN npm install -g pnpm \
    && composer install --no-interaction --no-dev --no-scripts --no-autoloader --prefer-dist \
    && pnpm install --frozen-lockfile

# Step 4: Copy full application files
COPY . /var/www

# Step 5: Build assets, clean up node_modules to save space, and optimize Composer autoloader
RUN pnpm run build \
    && rm -rf node_modules \
    && composer dump-autoload --optimize --no-dev

# Step 6: Fix permissions
RUN chown -R www-data:www-data /var/www/storage /var/www/bootstrap/cache \
    && chmod -R 775 /var/www/storage /var/www/bootstrap/cache

EXPOSE 80

# Launch supervisord immediately so the web server binds to port 80 with zero boot delay
CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]