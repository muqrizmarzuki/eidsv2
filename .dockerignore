.git
.gitignore
.gitattributes
.github

# Never bake local secrets or local state into the image
.env
.env.*
!.env.example
auth.json

# Rebuilt inside the image
vendor
node_modules
public/build
public/hot
public/storage
public/fonts-manifest.dev.json

