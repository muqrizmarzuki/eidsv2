.agents
.interface-design
.codex
.cursor
.idea
.nova
.vscode
.zed
.phpactor.json
.phpunit.cache
.phpunit.result.cache

# Runtime state
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
storage/pail
*.log

# Docs / dev compose — not needed at runtime
docker-compose.yml
Dockerfile
Dockerfile.vercel
tests
docs
*.md
